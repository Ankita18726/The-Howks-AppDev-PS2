# Public values are bundled into the app and must never contain secrets.
# Web/iOS Simulator can use localhost. For Expo Go on a physical phone,
# replace localhost with this computer's LAN IP (for example 192.168.1.20).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Server-only Gemini classification. Never prefix these with EXPO_PUBLIC_.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Server-only speech-to-text configuration. Never prefix these with EXPO_PUBLIC_.
# Choose "groq" or "openai". Groq is the hackathon default.
SPEECH_PROVIDER=groq
GROQ_API_KEY=
# OPENAI_API_KEY=
# SPEECH_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
