rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/queries/{queryId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'problem', 'analysis', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.problem is string
        && request.resource.data.problem.size() >= 10
        && request.resource.data.problem.size() <= 4000
        && request.resource.data.analysis is map
        && request.resource.data.createdAt == request.time;

      allow get, list, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
